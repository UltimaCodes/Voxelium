#version 460 core

// GPU-driven culling: one invocation per loaded chunk. Frustum-tests the chunk AABB
// and, if visible, appends a draw command + its camera-relative offset. The vertex
// shader then indexes offsets by gl_DrawID. Chunk positions are stored in chunk units
// as ints so the camera-relative math stays exact at any distance from the origin.

layout(local_size_x = 64) in;

struct ChunkMeta {
    ivec4 posFirst; // xyz = chunk pos in chunk units, w = first quad in the arena
    uvec4 countPad; // x = quad count, y = sunlit
    // The quads in groups by direction, +X -X +Y -Y +Z -Z then cross-plane foliage (zw of
    // groupsB: foliage, unused). All zero when the range is not grouped.
    uvec4 groupsA;
    uvec4 groupsB;
};

// Five words a command: DrawElementsIndirectCommand for the chunks (count, instances, first
// index, base vertex, base instance), DrawArraysIndirectCommand plus a pad for the water.
struct DrawCmd {
    uint w[5];
};

layout(std430, binding = 0) readonly buffer Meta { ChunkMeta meta[]; };
layout(std430, binding = 1) writeonly buffer Cmds { DrawCmd cmds[]; };
layout(std430, binding = 2) buffer DrawCount { uint drawCount; uint chunkCount; };
layout(std430, binding = 3) writeonly buffer Offsets { vec4 offsets[]; };
layout(std430, binding = 4) readonly buffer Vis { uint visBits[]; }; // cave-culling flood result

layout(location = 0) uniform vec4 uPlanes[6]; // 5 for the perspective view, 6 for ortho cascades
layout(location = 6) uniform ivec3 uCameraChunk;
layout(location = 7) uniform vec3 uCameraFrac;
layout(location = 8) uniform uint uChunkCount;
layout(location = 9) uniform uint uCaveCull;
layout(location = 10) uniform uint uPlaneCount;
// far shadow cascade: skip chunks sealed from the sky, see ShadowMap::render. Not exact: they hold
// the only faces that shade a cave. Nobody sees into one from there.
layout(location = 11) uniform uint uSunlitOnly;
// The cached shadow cascades are redrawn a slice a frame (ShadowMap::kSlices): with uSlices
// set (8, 16 or 32), only the chunks whose cell of a 4x4x2 checkerboard falls in slice uSlice.
// Keyed on the chunk's position, not its slot here, because the slots are reordered whenever
// chunks load or unload and a chunk must not move to a slice that has already been drawn.
layout(location = 12) uniform uint uSlice;
layout(location = 15) uniform uint uSlices; // 0: everything
// 6: the chunks, two indexed triangles a quad. 4: the water, which draws each quad as one
// 4-vertex patch for the tessellation stages to subdivide.
layout(location = 13) uniform uint uVertsPerQuad;
// 1: draw only the direction groups with a face the camera can be in front of. Every face of a
// group faces away from a camera on the far side of the chunk's slab, and back faces are culled
// anyway, so this drops them before the vertex shader instead of after it.
layout(location = 14) uniform uint uFaceCull;

// Quads one indexed draw can reach: the index buffer's length (Renderer.cpp kIndexedQuads).
const uint kIndexedQuads = 262144u;

DrawCmd command(uint firstQuad, uint quads) {
    DrawCmd c;
    if (uVertsPerQuad == 4u)
        c.w = uint[5](quads * 4u, 1u, firstQuad * 4u, 0u, 0u);
    else // gl_VertexID is the base vertex plus the index, so quad * 4 + corner indexes the arena
        c.w = uint[5](min(quads, kIndexedQuads) * 6u, 1u, 0u, firstQuad * 4u, 0u);
    return c;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uChunkCount)
        return;
    if (uCaveCull != 0u && (visBits[i >> 5] & (1u << (i & 31u))) == 0u)
        return; // not reachable from the camera through open space
    if (uSunlitOnly != 0u && meta[i].countPad.y == 0u)
        return; // sealed from the sky: contributes nothing to a sun shadow map

    ChunkMeta m = meta[i];
    if (uSlices != 0u && (uint(m.posFirst.x & 3) | (uint(m.posFirst.z & 3) << 2) |
                          (uint(m.posFirst.y & 1) << 4)) % uSlices != uSlice)
        return;
    vec3 offset = vec3((m.posFirst.xyz - uCameraChunk) * 32) - uCameraFrac;
    vec3 center = offset + 16.0;
    for (uint p = 0u; p < uPlaneCount; ++p) {
        vec3 n = uPlanes[p].xyz;
        if (dot(n, center) + uPlanes[p].w + dot(abs(n), vec3(16.0)) < 0.0)
            return; // box entirely behind this plane
    }

    uint counts[7] = uint[7](m.groupsA.x, m.groupsA.y, m.groupsA.z, m.groupsA.w, m.groupsB.x, m.groupsB.y, m.groupsB.z);
    uint grouped = counts[0] + counts[1] + counts[2] + counts[3] + counts[4] + counts[5] + counts[6];
    if (uFaceCull == 0u || grouped == 0u) {
        uint slot = atomicAdd(drawCount, 1u);
        cmds[slot] = command(uint(m.posFirst.w), m.countPad.x);
        offsets[slot] = vec4(offset, 0.0);
        atomicAdd(chunkCount, 1u);
        return;
    }
    // +X faces sit on planes from the chunk's low side + 1 up: a camera at or below that low side is
    // behind every one of them. A block of margin either way; the cross-plane foliage always draws.
    bool open[7] = bool[7](offset.x < 0.0, offset.x + 32.0 > 0.0, offset.y < 0.0, offset.y + 32.0 > 0.0,
                           offset.z < 0.0, offset.z + 32.0 > 0.0, true);
    // neighbouring open groups are one draw
    uint runFirst[7], runCount[7];
    uint runs = 0u, at = uint(m.posFirst.w);
    bool inRun = false;
    for (int g = 0; g < 7; ++g) {
        if (counts[g] == 0u)
            continue;
        if (open[g]) {
            if (inRun) {
                runCount[runs - 1u] += counts[g];
            } else {
                runFirst[runs] = at;
                runCount[runs] = counts[g];
                ++runs;
                inRun = true;
            }
        } else {
            inRun = false;
        }
        at += counts[g];
    }
    if (runs == 0u)
        return;
    uint slot = atomicAdd(drawCount, runs);
    for (uint r = 0u; r < runs; ++r) {
        cmds[slot + r] = command(runFirst[r], runCount[r]);
        offsets[slot + r] = vec4(offset, 0.0);
    }
    atomicAdd(chunkCount, 1u);
}
