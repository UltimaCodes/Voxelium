{
  "version": 6,
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "Windows / MSVC (VS 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/msvc",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "mingw",
      "displayName": "Windows / GCC WinLibs-MinGW (Ninja Multi-Config)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/mingw",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "gcc",
      "displayName": "Linux / GCC (Ninja Multi-Config)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/gcc",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "harden",
      "displayName": "Windows / GCC, optimized WITH libstdc++ assertions",
      "description": "Release speed plus _GLIBCXX_ASSERTIONS and frame pointers. Debug's container assertions are what caught the light-vs-worker race, but a Debug build is too slow to reach the states a long stream-in produces; this config gets the same assertions at a speed that does.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/harden",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS": "-D_GLIBCXX_ASSERTIONS -fno-omit-frame-pointer -g"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "msvc-release", "configurePreset": "msvc", "configuration": "Release" },
    { "name": "mingw-debug", "configurePreset": "mingw", "configuration": "Debug" },
    { "name": "mingw-release", "configurePreset": "mingw", "configuration": "Release" },
    { "name": "gcc-debug", "configurePreset": "gcc", "configuration": "Debug" },
    { "name": "gcc-release", "configurePreset": "gcc", "configuration": "Release" },
    { "name": "harden-release", "configurePreset": "harden", "configuration": "Release" }
  ]
}
